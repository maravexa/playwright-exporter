[Unit]
Description=Playwright Prometheus Exporter
Documentation=https://github.com/maravexa/playwright-exporter
After=network.target

[Service]
Type=simple
User=playwright-exporter
Group=playwright-exporter
ExecStart=/usr/bin/playwright-exporter -config /etc/playwright-exporter/config.yaml
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
Restart=on-failure
RestartSec=5s
MemoryMax=2G
TimeoutStopSec=10
# Stop the entire service cgroup, including detached test/browser descendants.
# This applies to service stop/restart, not an individual schedule timeout.
KillMode=control-group
SendSIGKILL=yes

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# PrivateTmp provides writable /tmp inside the service namespace.
ReadWritePaths=/opt/playwright-browsers /opt/playwright-tests
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
